{
    "manufacturer": "MYKB",
    "keyboard_name": "S9B",
    "maintainer": "DustyDiamond",
    "url": "https://github.com/DustyDiamond/s9b-vial-firmware",
    "processor": "STM32F103",
    "bootloader": "custom",
    "usb": {
        "vid": "0xA286",
        "pid": "0x1DAD",
        "device_version": "2.0.0"
    },
    "diode_direction": "COL2ROW",
    "matrix_pins": {
        "rows": ["B12", "A6", "A7"],
        "cols": ["B11", "B10", "B1"]
    },
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": false,
        "rgblight": true
    },
    "bootmagic": {
        "matrix": [2, 0]
    },
    "eeprom": {
        "driver": "wear_leveling",
        "wear_leveling": {
            "driver": "embedded_flash",
            "backing_size": 8192,
            "logical_size": 4096
        }
    },
    "ws2812": {
        "driver": "pwm",
        "pin": "A8"
    },
    "rgblight": {
        "driver": "ws2812",
        "led_count": 9,
        "max_brightness": 200,
        "hue_steps": 8,
        "saturation_steps": 17,
        "brightness_steps": 17,
        "sleep": true,
        "layers": {
            "enabled": true,
            "blink": true,
            "max": 16,
            "override_rgb": true
        },
        "animations": {
            "breathing": true,
            "rainbow_mood": true,
            "rainbow_swirl": true,
            "snake": true,
            "twinkle": true
        },
        "default": {
            "animation": "static_light",
            "hue": 85,
            "sat": 255,
            "val": 120
        }
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"label": "7", "matrix": [0, 0], "x": 0, "y": 0},
                {"label": "8", "matrix": [0, 1], "x": 1, "y": 0},
                {"label": "9", "matrix": [0, 2], "x": 2, "y": 0},
                {"label": "4", "matrix": [1, 0], "x": 0, "y": 1},
                {"label": "5", "matrix": [1, 1], "x": 1, "y": 1},
                {"label": "6", "matrix": [1, 2], "x": 2, "y": 1},
                {"label": "1", "matrix": [2, 0], "x": 0, "y": 2},
                {"label": "2", "matrix": [2, 1], "x": 1, "y": 2},
                {"label": "3", "matrix": [2, 2], "x": 2, "y": 2}
            ]
        }
    }
}
